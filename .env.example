# HMR - Variables de entorno
# Copia este archivo a .env y rellena los valores.
# Sin un .env, Docker usa los valores por defecto (suficientes para desarrollo local).

# --- Base de datos ---
# Solo cambia estos si no usas los valores por defecto del contenedor postgres.
DB_USER=hmr
DB_PASSWORD=hmr_secret
DB_NAME=hmr_db

# --- Seguridad ---
# REQUERIDO en producción. Genera uno seguro: openssl rand -hex 32
# En desarrollo, si no lo pones, se usa "dev_secret" automáticamente.
JWT_SECRET=change_me_in_production

# --- CORS ---
# Lista de orígenes permitidos separados por coma.
#  Desarrollo:     http://localhost:5173,http://127.0.0.1:5173
#  Producción:     https://tu-dominio.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173